# Uncomment this line to define a global platform for your project
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

# Umbrella mode (see the README): with BAROMETER_FLUTTER_UMBRELLA_MODULE set, the plugin
# compiles against the umbrella framework vendored by the local barometer_example_umbrella
# pod, and pods link statically so that the facade is linked once, into the application.
umbrella_mode = !ENV.fetch('BAROMETER_FLUTTER_UMBRELLA_MODULE', '').strip.empty?
ENV['BAROMETER_FLUTTER_UMBRELLA_POD'] = 'barometer_example_umbrella' if umbrella_mode

target 'Runner' do
  if umbrella_mode
    use_frameworks! :linkage => :static
    pod 'barometer_example_umbrella', :path => 'umbrella'
  else
    use_frameworks!
  end

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end

  # In umbrella mode the XCTests' `@testable import barometer_flutter` also loads the plugin's
  # BarometerUmbrella module, which needs the same search path and module name as the plugin.
  next unless umbrella_mode
  umbrella_module = ENV.fetch('BAROMETER_FLUTTER_UMBRELLA_MODULE').strip
  plugin = installer.pod_targets.find { |t| t.name == 'barometer_flutter' }
  umbrella_dir = "#{plugin.pod_target_srcroot}/barometer_flutter/Umbrella"
  installer.aggregate_targets.select { |t| t.name.end_with?('RunnerTests') }.each do |target|
    target.xcconfigs.each do |config_name, xcconfig|
      settings = xcconfig.attributes
      settings['SWIFT_INCLUDE_PATHS'] = "#{settings.fetch('SWIFT_INCLUDE_PATHS', '$(inherited)')} \"#{umbrella_dir}\""
      settings['OTHER_SWIFT_FLAGS'] = "#{settings.fetch('OTHER_SWIFT_FLAGS', '$(inherited)')} -Xcc -DBAROMETER_UMBRELLA_MODULE=#{umbrella_module}"
      xcconfig.save_as(target.xcconfig_path(config_name))
    end
  end
end
